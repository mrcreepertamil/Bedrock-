{
  "namespace": "bedrockpp_main_menu",
  "menu_backplate": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": "$bedrockpp_color_background",
    "alpha": 0.94,
    "size": [
      "100%",
      "100%"
    ]
  },
  "menu_accent_bar": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": "$bedrockpp_color_accent",
    "size": [
      "100%",
      3
    ]
  },
  "menu_title": {
    "type": "label",
    "text": "BEDROCK++",
    "color": "$bedrockpp_color_text",
    "font_size": "extra_large",
    "shadow": true,
    "size": [
      "100%",
      "default"
    ]
  },
  "menu_subtitle": {
    "type": "label",
    "text": "A better Bedrock experience.",
    "color": "$bedrockpp_color_text_muted",
    "font_size": "small",
    "shadow": false,
    "size": [
      "100%",
      "default"
    ]
  },
  "menu_action_tile": {
    "type": "panel",
    "size": [
      "100%",
      34
    ],
    "controls": [
      {
        "tile_background": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": "$bedrockpp_color_surface_raised",
          "alpha": 1,
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "tile_label": {
          "type": "label",
          "text": "$bedrockpp_action_label",
          "color": "$bedrockpp_color_text",
          "font_size": "normal",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "100%",
            "default"
          ],
          "text_alignment": "center"
        }
      }
    ]
  },
  "main_menu_layout": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "backplate@bedrockpp_main_menu.menu_backplate": {}
      },
      {
        "content_panel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            "8%",
            0
          ],
          "size": [
            300,
            "100%c"
          ],
          "controls": [
            {
              "accent@bedrockpp_main_menu.menu_accent_bar": {}
            },
            {
              "title@bedrockpp_main_menu.menu_title": {
                "offset": [
                  0,
                  12
                ]
              }
            },
            {
              "subtitle@bedrockpp_main_menu.menu_subtitle": {
                "offset": [
                  0,
                  3
                ]
              }
            },
            {
              "menu_spacing": {
                "type": "panel",
                "size": [
                  1,
                  18
                ]
              }
            },
            {
              "play_tile@bedrockpp_main_menu.menu_action_tile": {
                "$bedrockpp_action_label": "PLAY"
              }
            },
            {
              "realms_tile@bedrockpp_main_menu.menu_action_tile": {
                "$bedrockpp_action_label": "REALMS"
              }
            },
            {
              "settings_tile@bedrockpp_main_menu.menu_action_tile": {
                "$bedrockpp_action_label": "SETTINGS"
              }
            }
          ]
        }
      }
    ]
  }
}